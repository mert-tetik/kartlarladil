NEXT_PUBLIC_SITE_URL=https://www.foxiesdeck.com
TWA_PACKAGE_NAME=com.LigidTools.Glidecore
NEXT_PUBLIC_TWA_PACKAGE_NAME=com.LigidTools.Glidecore
TWA_SHA256_FINGERPRINT=D4:73:E8:A7:A8:C7:7B:21:75:EB:5E:63:F4:D4:FB:2C:89:AD:85:82:02:5A:BA:1A:FE:11:71:E7:DB:EE:48:42

# TWA build configuration (optional overrides)
# TWA_PACKAGE_ID=com.LigidTools.Glidecore
# TWA_VERSION_CODE=121
# TWA_VERSION_NAME=4.3.8
# TWA_KEYSTORE_PATH=C:\\Users\\CASPER\\user.keystore
# TWA_KEYSTORE_ALIAS=yeiexl

# Google Play Billing (TWA Digital Goods API)
# Service account JSON key content as a single-line string
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY_JSON=
GOOGLE_PLAY_PACKAGE_NAME=com.LigidTools.Glidecore
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_CRON_SECRET=
OPENAI_API_KEY=
OPENAI_AI_PRACTICE_MODEL=gpt-5-nano
# Server-only PoYo key used by the private social content studio video generator.
POYO_API_KEY=
# Optional server-only signing secret for the private social content studio session.
SOCIAL_STUDIO_AUTH_SECRET=
# Server-only AES-256-GCM key for encrypted social provider tokens.
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SOCIAL_AUTOMATION_TOKEN_ENCRYPTION_KEY=
# OAuth callback origin for social providers. Keep this as the deployed site URL.
SOCIAL_AUTOMATION_OAUTH_BASE_URL=https://www.foxiesdeck.com
# Server-only HMAC secret for short-lived social OAuth state cookies.
SOCIAL_AUTOMATION_OAUTH_STATE_SECRET=
# X OAuth 2.0 confidential client credentials. Configure the callback URL in X as
# https://www.foxiesdeck.com/api/twitter-automation/oauth/x/callback
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
# Pinterest OAuth 2.0 confidential client credentials. Configure the callback URL in Pinterest as
# https://www.foxiesdeck.com/api/twitter-automation/oauth/pinterest/callback
PINTEREST_OAUTH_CLIENT_ID=
PINTEREST_OAUTH_CLIENT_SECRET=
# Google OAuth 2.0 web client credentials for the YouTube Data API. Configure the callback URL in Google Cloud as
# https://www.foxiesdeck.com/api/twitter-automation/oauth/youtube/callback
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# Meta App credentials for Instagram API with Instagram Login. Configure the callback URL in Meta as
# https://www.foxiesdeck.com/api/twitter-automation/oauth/instagram/callback
INSTAGRAM_OAUTH_APP_ID=
INSTAGRAM_OAUTH_APP_SECRET=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_BASIC_VARIANT_ID=
LEMONSQUEEZY_BASIC_YEARLY_VARIANT_ID=
LEMONSQUEEZY_PRO_VARIANT_ID=
LEMONSQUEEZY_PRO_YEARLY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
